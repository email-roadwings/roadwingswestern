        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased selection:bg-amber-500 selection:text-white">

    <!-- Top Announcement Bar -->
    <div class="bg-slate-900 text-slate-300 text-xs py-2.5 px-4 border-b border-slate-800">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
            <div class="flex items-center space-x-6">
                <span class="flex items-center gap-2">
                    <i class="fa-solid me-1 fa-building text-amber-500"></i> CIN: U60230MH2018PTC313151
                </span>
                <span class="hidden md:inline-flex items-center gap-2">
                    <i class="fa-solid me-1 fa-location-dot text-amber-500"></i> Andheri East, Mumbai, Maharashtra
                </span>
            </div>
            <div class="flex items-center space-x-4">
                <a href="tel:+919324535520" class="hover:text-amber-400 transition flex items-center gap-1.5">
                    <i class="fa-solid fa-phone text-amber-500"></i> +91 9324535520 / +91 8104143209
                </a>
                <a href="mailto:email@roadwingswestern.com" class="hover:text-amber-400 transition flex items-center gap-1.5">
                    <i class="fa-regular fa-envelope text-amber-500"></i> email@roadwingswestern.com
                </a>
            </div>
        </div>
    </div>

    <!-- Main Navigation Header -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <!-- Brand Logo with Updated Image -->
                <a href="#" class="flex items-center space-x-3 group">
                    <img 
                        src="logo_2.jpg" 
                        alt="Roadwings Logo" 
                        class="w-12 h-12 object-contain group-hover:scale-105 transition-transform duration-300"
                    />
                    <div>
                        <span class="text-xl font-extrabold tracking-tight text-slate-900 block leading-none">ROADWINGS WESTERN</span>
                        <span class="text-xs font-semibold text-amber-600 tracking-widest uppercase">PVT LTD</span>
                    </div>
                </a>

                <!-- Nav Menu -->
                <nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-slate-700">
                    <a href="#about" class="hover:text-amber-600 transition">About Us</a>
                    <a href="#handling" class="hover:text-amber-600 transition">Container Handling</a>
                    <a href="#transportation" class="hover:text-amber-600 transition">Transportation</a>
                    <a href="#corridors" class="hover:text-amber-600 transition">Network & Ports</a>
                    <a href="#contact" class="hover:text-amber-600 transition">Contact Us</a>
                </nav>

                <!-- Action Button -->
                <div class="hidden sm:flex items-center">
                    <a href="#contact" class="bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold px-5 py-2.5 rounded-lg shadow-md hover:shadow-lg transition duration-200 flex items-center gap-2 text-sm">
                        <i class="fa-solid fa-headset"></i> Get In Touch
                    </a>
                </div>
            </div>
        </div>
