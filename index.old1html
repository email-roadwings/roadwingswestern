    <!-- Hero Section -->
    <section class="relative bg-slate-900 text-white py-12 lg:py-16 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
                
                <!-- Left Content Column -->
                <div class="lg:col-span-7">
                    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-semibold uppercase tracking-wider mb-6">
                        <i class="fa-solid fa-shield-halved"></i> Premier Industry Partner
                    </div>
                    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight mb-6">
                        Precision Container Handling & High-Capacity Road Transportation
                    </h1>
                    <p class="text-base sm:text-lg text-slate-300 font-normal leading-relaxed mb-8">
                        Bridging Ports, Inland Container Depots (ICDs), and Industrial Plants across Western India with dedicated fleet management, reach-stacker operations, and heavy payload handling.
                    </p>
                    <div class="flex flex-wrap gap-4">
                        <a href="#contact" class="bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold px-6 py-3 rounded-xl shadow-lg hover:shadow-amber-500/20 transition duration-200 text-sm sm:text-base inline-flex items-center gap-2">
                            <i class="fa-solid fa-phone"></i> Contact Operations
                        </a>
                        <a href="#transportation" class="bg-slate-800 hover:bg-slate-700 text-white font-semibold px-6 py-3 rounded-xl border border-slate-700 transition duration-200 text-sm sm:text-base inline-flex items-center gap-2">
                            <i class="fa-solid fa-truck-fast"></i> Explore Fleet
                        </a>
                    </div>
                </div>

                <!-- Right Image Column -->
                <div class="lg:col-span-5">
                    <div class="relative bg-slate-800 border border-slate-700 p-2 sm:p-3 rounded-2xl shadow-2xl">
                        <div class="overflow-hidden rounded-xl bg-slate-950 aspect-[4/3] w-full flex items-center justify-center">
                            <img 
                                src="1709762615074a.avif" 
                                alt="Reach Stacker Container Lifting Equipment" 
                                class="w-full h-full object-cover object-center rounded-xl hover:scale-105 transition duration-500"
                            >
                        </div>
                        <div class="mt-3 px-2 flex items-center justify-between text-xs text-slate-400 font-medium">
                            <span class="flex items-center gap-1.5 text-amber-400">
                                <i class="fa-solid fa-circle-check"></i> High Reach Operations
                            </span>
                            <span>45 Ton Lifting Capacity</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Highlights Bar -->
    <section class="bg-white border-y border-slate-200 py-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
                <div class="p-4">
                    <div class="text-3xl sm:text-4xl font-extrabold text-slate-900 mb-1">JNPT & Ports</div>
                    <div class="text-xs sm:text-sm text-slate-500 font-medium">Direct Port Drayage</div>
                </div>
                <div class="p-4 border-l border-slate-200">
                    <div class="text-3xl sm:text-4xl font-extrabold text-amber-600 mb-1">Heavy Fleet</div>
                    <div class="text-xs sm:text-sm text-slate-500 font-medium">Multi-Axle Trailers</div>
                </div>
                <div class="p-4 border-l border-slate-200">
                    <div class="text-3xl sm:text-4xl font-extrabold text-slate-900 mb-1">20ft / 40ft</div>
                    <div class="text-xs sm:text-sm text-slate-500 font-medium">Dry & High-Cube</div>
                </div>
                <div class="p-4 border-l border-slate-200">
                    <div class="text-3xl sm:text-4xl font-extrabold text-amber-600 mb-1">Heavy Duty</div>
                    <div class="text-xs sm:text-sm text-slate-500 font-medium">Reach Stacker Yard Support</div>
                </div>
            </div>
        </div>
    </section>

    <!-- About Us Section -->
    <section id="about" class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="max-w-3xl mx-auto text-center mb-12">
                <span class="text-amber-600 font-bold uppercase text-xs tracking-widest block mb-2">Who We Are</span>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">Roadwings at a Glance</h2>
                <div class="w-16 h-1 bg-amber-500 mx-auto mt-4 rounded-full"></div>
            </div>
            <div class="max-w-4xl mx-auto bg-slate-50 border border-slate-200 rounded-2xl p-8 sm:p-10 shadow-sm leading-relaxed text-slate-700 space-y-4">
                <p>
                    Roadwings is a leading integrated cargo-handling and transportation company in India, with over 40 years of industry experience. We provide reliable and efficient solutions across transportation, warehousing, cargo handling, and supply chain management.
                </p>
                <p>
                    With a strong pan-India presence, modern operations equipment, and expertise in managing large-scale operations, Roadwings has built long-standing relationships with leading organizations including CONCOR, Balmer Lawrie, FCI, JNPT, Kolkata Port Trust, Mumbai Port Trust, and several other reputed public- and private-sector enterprises.
                </p>
                <p>
                    With experience, infrastructure, and a customer-first approach, Roadwings is committed to delivering seamless, dependable, and value-driven solutions.
                </p>

                <div class="grid sm:grid-cols-3 gap-6 mt-8 pt-6 border-t border-slate-200 text-sm">
                    <div>
                        <span class="block font-bold text-slate-900 mb-1"><i class="fa-solid fa-clock-rotate-left text-amber-500 me-2"></i>Industry Experience</span>
                        <span class="text-slate-600">40+ Years of Excellence</span>
                    </div>
                    <div>
                        <span class="block font-bold text-slate-900 mb-1"><i class="fa-solid fa-network-wired text-amber-500 me-2"></i>Network Coverage</span>
                        <span class="text-slate-600">Pan-India Presence</span>
                    </div>
                    <div>
                        <span class="block font-bold text-slate-900 mb-1"><i class="fa-solid fa-handshake text-amber-500 me-2"></i>Key Esteemed Clients</span>
                        <span class="text-slate-600">CONCOR, JNPT, FCI & More</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Core Focus 1: Container Handling Services -->
    <section id="handling" class="py-20 bg-slate-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <span class="text-amber-600 font-bold uppercase text-xs tracking-widest block mb-2">Core Focus Area 01</span>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">Container Handling Services</h2>
                <div class="w-16 h-1 bg-amber-500 mx-auto mt-4 rounded-full"></div>
                <p class="text-slate-600 mt-4 text-base">We operate specialized heavy-lift equipment and yard infrastructure designed to handle high-density container movement without bottlenecking your supply chain.</p>
            </div>

            <!-- Reach Stacker Image Integration -->
            <div class="mb-12 bg-white p-4 sm:p-6 rounded-2xl border border-slate-200 shadow-md grid lg:grid-cols-12 gap-8 items-center">
                <div class="lg:col-span-6 overflow-hidden rounded-xl">
                    <img src="02-TR4535.avif" alt="Container Reach Stacker Equipment" class="w-full h-80 object-cover rounded-xl hover:scale-105 transition duration-500">
                </div>
                <div class="lg:col-span-6 space-y-4">
                    <span class="inline-block px-3 py-1 bg-amber-100 text-amber-800 font-semibold text-xs rounded-md uppercase tracking-wide">Heavy Machinery Fleet</span>
                    <h3 class="text-2xl font-bold text-slate-900">High-Capacity Reach Stacker Yard Operations</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">
                        Equipped with high-reach container handlers and heavy reach stackers capable of lifting up to 45 tons, our equipment ensures swift stacking, loading, and terminal transfer operations for ICD and port yards.
                    </p>
                    <ul class="text-sm text-slate-700 space-y-2">
                        <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-amber-500"></i> Heavy Lift Capacities (20ft, 40ft, High Cube)</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-amber-500"></i> Fast Yard Stacking and Rail-to-Road Transfers</li>
                    </ul>
                </div>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
                <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-200 flex flex-col justify-between group">
                    <div>
                        <div class="w-14 h-14 bg-amber-100 text-amber-600 rounded-xl flex items-center justify-center text-2xl mb-6 group-hover:bg-amber-500 group-hover:text-slate-950 transition-colors">
                            <i class="fa-solid fa-dolly"></i>
                        </div>
                        <h3 class="text-xl font-bold text-slate-900 mb-3">Terminal & Yard Operations</h3>
                        <p class="text-slate-600 text-sm leading-relaxed">
                            Systematic lifting, stacking, and destacking of loaded and empty ISO containers using high-capacity reach stackers and heavy cranes.
                        </p>
                    </div>
                </div>

                <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-200 flex flex-col justify-between group">
                    <div>
                        <div class="w-14 h-14 bg-amber-100 text-amber-600 rounded-xl flex items-center justify-center text-2xl mb-6 group-hover:bg-amber-500 group-hover:text-slate-950 transition-colors">
                            <i class="fa-solid fa-boxes-packing"></i>
                        </div>
                        <h3 class="text-xl font-bold text-slate-900 mb-3">Stuffing & De-stuffing</h3>
                        <p class="text-slate-600 text-sm leading-relaxed">
                            On-site and yard cargo loading and unloading under expert supervision to ensure total safety and zero payload damage.
                        </p>
                    </div>
                </div>

                <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-200 flex flex-col justify-between group">
                    <div>
                        <div class="w-14 h-14 bg-amber-100 text-amber-600 rounded-xl flex items-center justify-center text-2xl mb-6 group-hover:bg-amber-500 group-hover:text-slate-950 transition-colors">
                            <i class="fa-solid fa-warehouse"></i>
                        </div>
                        <h3 class="text-xl font-bold text-slate-900 mb-3">Empty Container Management</h3>
                        <p class="text-slate-600 text-sm leading-relaxed">
                            Secure yard storage, structural inspection, maintenance, and strategic repositioning solutions for shipping lines and fleet operators.
                        </p>
                    </div>
                </div>

                <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-200 flex flex-col justify-between group">
                    <div>
                        <div class="w-14 h-14 bg-amber-100 text-amber-600 rounded-xl flex items-center justify-center text-2xl mb-6 group-hover:bg-amber-500 group-hover:text-slate-950 transition-colors">
                            <i class="fa-solid fa-truck-ramp-box"></i>
                        </div>
                        <h3 class="text-xl font-bold text-slate-900 mb-3">Specialized Heavy Cargo</h3>
                        <p class="text-slate-600 text-sm leading-relaxed">
                            Customized lifting and handling protocols for Open-Top, Flat-Rack, and high-density industrial container payloads.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Core Focus 2: Container Transportation & Drayage -->
    <section id="transportation" class="py-20 bg-white border-t border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <span class="text-amber-600 font-bold uppercase text-xs tracking-widest block mb-2">Core Focus Area 02</span>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">Container Transportation & Drayage</h2>
                <div class="w-16 h-1 bg-amber-500 mx-auto mt-4 rounded-full"></div>
                <p class="text-slate-600 mt-4 text-base">Our heavy fleet is engineered to carry standard, heavy, and over-dimensional containerized freight across major trade corridors.</p>
            </div>

            <!-- Fleet Image & Fleet Specifications Grid -->
            <div class="grid lg:grid-cols-12 gap-8 items-stretch mb-8">
                <!-- Trailer Image Card -->
                <div class="lg:col-span-5 bg-slate-900 rounded-2xl border border-slate-800 p-4 flex flex-col justify-between overflow-hidden group shadow-xl">
                    <div class="overflow-hidden rounded-xl h-full">
                        <img src="istockphoto-2098081937-612x612.avif" alt="Container Transportation Trailer Fleet" class="w-full h-full object-cover min-h-[250px] group-hover:scale-105 transition duration-500">
                    </div>
                    <div class="pt-4 text-xs font-medium text-slate-300 flex items-center gap-2">
                        <i class="fa-solid fa-truck text-amber-500"></i> High-capacity multi-axle trailer drayage across major shipping corridors
                    </div>
                </div>

                <!-- Fleet Specifications Table -->
                <div class="lg:col-span-7 bg-slate-900 text-white rounded-2xl shadow-xl overflow-hidden border border-slate-800 flex flex-col justify-between">
                    <div class="px-6 py-5 border-b border-slate-800 bg-slate-950/60 flex items-center justify-between">
                        <h3 class="text-lg font-bold flex items-center gap-2 text-amber-400">
                            <i class="fa-solid fa-truck-moving"></i> Fleet Capabilities & Specifications
                        </h3>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-950/40 text-slate-400 text-xs uppercase tracking-wider border-b border-slate-800">
                                    <th class="py-4 px-6 font-semibold">Container Type</th>
                                    <th class="py-4 px-6 font-semibold">Fleet Specification</th>
                                    <th class="py-4 px-6 font-semibold">Ideal Cargo / Industry</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-800 text-sm">
                                <tr class="hover:bg-slate-800/50 transition">
                                    <td class="py-4 px-6 font-bold text-amber-400 flex items-center gap-2">
                                        <i class="fa-solid fa-box"></i> 20ft & 40ft Standard Dry (GP / HQ)
                                    </td>
                                    <td class="py-4 px-6 text-slate-300">Heavy-duty multi-axle trailers with mechanical twist-lock safety systems</td>
                                    <td class="py-4 px-6 text-slate-400">General manufacturing, FMCG, Packaging, Textiles</td>
                                </tr>
                                <tr class="hover:bg-slate-800/50 transition">
                                    <td class="py-4 px-6 font-bold text-amber-400 flex items-center gap-2">
                                        <i class="fa-solid fa-weight-hanging"></i> Heavy Payload / High Cube
                                    </td>
                                    <td class="py-4 px-6 text-slate-300">High-torque prime movers with reinforced chassis for max payloads</td>
                                    <td class="py-4 px-6 text-slate-400">Machinery, Auto Components, Metals, Industrial Goods</td>
                                </tr>
                                <tr class="hover:bg-slate-800/50 transition">
                                    <td class="py-4 px-6 font-bold text-amber-400 flex items-center gap-2">
                                        <i class="fa-solid fa-ship"></i> Port Drayage & Short Haul
                                    </td>
                                    <td class="py-4 px-6 text-slate-300">Fast-turnaround shuttles between JNPT/Ports, CFS yards, and ICDs</td>
                                    <td class="py-4 px-6 text-slate-400">Exim Traders, Freight Forwarders, Custom Brokers</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Operational Advantages -->
    <section class="py-20 bg-slate-900 text-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <span class="text-amber-500 font-bold uppercase text-xs tracking-widest block mb-2">Why Partner With Us</span>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">The Roadwings Western Advantage</h2>
                <div class="w-16 h-1 bg-amber-500 mx-auto mt-4 rounded-full"></div>
            </div>

            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <div class="bg-slate-800/60 p-6 rounded-xl border border-slate-700/60">
                    <div class="text-amber-500 text-2xl mb-4"><i class="fa-solid fa-lock"></i></div>
                    <h4 class="text-lg font-bold mb-2">Twist-Lock Security</h4>
                    <p class="text-slate-400 text-xs leading-relaxed">Purpose-built trailer beds with heavy twist-lock locking mechanism ensuring absolute cargo safety during transit.</p>
                </div>
                <div class="bg-slate-800/60 p-6 rounded-xl border border-slate-700/60">
                    <div class="text-amber-500 text-2xl mb-4"><i class="fa-solid fa-file-contract"></i></div>
                    <h4 class="text-lg font-bold mb-2">Regulatory Compliance</h4>
                    <p class="text-slate-400 text-xs leading-relaxed">Full e-Way Bill compliance, customs documentation assistance, and overweight movement permit clearances.</p>
                </div>
                <div class="bg-slate-800/60 p-6 rounded-xl border border-slate-700/60">
                    <div class="text-amber-500 text-2xl mb-4"><i class="fa-solid fa-user-shield"></i></div>
                    <h4 class="text-lg font-bold mb-2">Trained Fleet Crew</h4>
                    <p class="text-slate-400 text-xs leading-relaxed">Certified drivers trained in hazardous material handling, heavy payload maneuvering, and port protocols.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Strategic Network & Trade Corridors -->
    <section id="corridors" class="py-20 bg-slate-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid lg:grid-cols-12 gap-12 items-center">
                <div class="lg:col-span-5">
                    <span class="text-amber-600 font-bold uppercase text-xs tracking-widest block mb-2">Strategic Presence</span>
                    <h2 class="text-3xl font-extrabold text-slate-900 mb-4">Port & Trade Corridor Coverage</h2>
                    <p class="text-slate-600 text-sm leading-relaxed mb-6">
                        Operating out of our primary administrative hub in Andheri East, Mumbai, Roadwings Western Pvt Ltd seamlessly links primary maritime gateways to major industrial & manufacturing hubs.
                    </p>
                    <ul class="space-y-4 text-sm font-medium text-slate-700">
                        <li class="flex items-start gap-3">
                            <span class="w-6 h-6 rounded-full bg-amber-500 text-slate-950 flex items-center justify-center text-xs shrink-0 mt-0.5"><i class="fa-solid fa-check"></i></span>
                            <span><strong>Port Drayage:</strong> JNPT (Nhava Sheva), Hazira, and Mundra Port connectivity.</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="w-6 h-6 rounded-full bg-amber-500 text-slate-950 flex items-center justify-center text-xs shrink-0 mt-0.5"><i class="fa-solid fa-check"></i></span>
                            <span><strong>CFS & ICD Connections:</strong> Direct shuttle routes between Container Freight Stations and Inland Depots.</span>
                        </li>
                    </ul>
                </div>

                <div class="lg:col-span-7 bg-white p-8 rounded-2xl border border-slate-200 shadow-md">
                    <h3 class="text-lg font-bold text-slate-900 mb-6 flex items-center gap-2">
                        <i class="fa-solid fa-network-wired text-amber-500"></i> Primary Operational Hubs
                    </h3>
                    <div class="grid sm:grid-cols-2 gap-4">
                        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
                            <div class="font-bold text-slate-900 mb-1">Maharashtra & Mumbai Metro</div>
                            <p class="text-xs text-slate-500">JNPT, Nhava Sheva, Andheri Head Office, Bhiwandi Parks, Taloja & Pune Industrial Corridor.</p>
